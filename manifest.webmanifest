{
  "name": "SiteKick",
  "short_name": "SiteKick",
  "description": "Gebiet wählen, Pläne, Sonne und Schatten, 3D-Modell und Kennzahlen erzeugen und für CAD exportieren.",
  "lang": "de",
  "start_url": "./index.html",
